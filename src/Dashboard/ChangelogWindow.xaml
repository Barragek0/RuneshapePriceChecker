<Window x:Class="RuneshapePriceChecker.App.Dashboard.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#1A1D23"
        ResizeMode="CanResize"
        Title="What's New"
        MinWidth="480"
        MinHeight="400"
        Width="560"
        Height="600"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"
                Color="#1A1D23"/>
        <SolidColorBrush x:Key="BorderBrush"
                Color="#2E323A"/>
        <SolidColorBrush x:Key="TextPrimary"
                Color="#E8ECF1"/>
        <SolidColorBrush x:Key="GreenBrush"
                Color="#34D399"/>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#22262E"
                    Padding="16,12"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="What's New"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <Button Content="✕"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="#8A8F98"
                            BorderThickness="0"
                            FontSize="16"
                            Cursor="Hand"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="16,8">
                <FlowDocumentScrollViewer x:Name="ChangelogViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <Border Grid.Row="2"
                    Background="#22262E"
                    Padding="16,10">
                <Button x:Name="CloseBtn"
                        Width="100"
                        Height="32"
                        Background="{StaticResource GreenBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Content="Got it"
                        Cursor="Hand"
                        Click="Close_Click"
                        HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>
