<Window x:Class="RuneshapePriceChecker.App.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowActivated="False"
        Title="RuneshapePriceChecker"
        SourceInitialized="Window_SourceInitialized"
        MinWidth="500"
        MaxWidth="960"
        MinHeight="652"
        MaxHeight="652"
        Height="652"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ContentRendered="Window_ContentRendered"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#1A1D23"/>
        <SolidColorBrush x:Key="SurfaceAltBrush"
                         Color="#22262E"/>
        <SolidColorBrush x:Key="BorderBrush"
                         Color="#2E323A"/>
        <SolidColorBrush x:Key="TextPrimary"
                         Color="#E8ECF1"/>
        <SolidColorBrush x:Key="TextSecondary"
                         Color="#8A8F98"/>
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#4A9EFF"/>
        <SolidColorBrush x:Key="GreenBrush"
                         Color="#34D399"/>
        <SolidColorBrush x:Key="AmberBrush"
                         Color="#FBBF24"/>
        <SolidColorBrush x:Key="RedBrush"
                         Color="#F87171"/>
        <SolidColorBrush x:Key="YellowBrush"
                         Color="#E8C547"/>
        <SolidColorBrush x:Key="ScrollThumbBrush"
                         Color="#4A4E58"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush"
                         Color="#5A5E68"/>
        <SolidColorBrush x:Key="ScrollTrackBrush"
                         Color="#1A1D23"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush"
                         Color="#22272E"/>
        <SolidColorBrush x:Key="SurfaceAltHoverBrush"
                         Color="#2A2E38"/>
        <SolidColorBrush x:Key="DarkGreenBgBrush"
                         Color="#0D3320"/>
        <SolidColorBrush x:Key="GreenBtnBrush"
                         Color="#118C5C"/>

        <Style TargetType="ToolTip">
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="250"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="3000"/>
            <Setter Property="Background"
                    Value="#252830"/>
            <Setter Property="Foreground"
                    Value="#D8DCE4"/>
            <Setter Property="BorderBrush"
                    Value="#3A3E48"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Padding"
                    Value="10,7"/>
            <Setter Property="MaxWidth"
                    Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                IsHitTestVisible="False">
                            <ContentPresenter x:Name="TooltipContent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping"
                                                Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="Loaded"
                         Handler="ToolTip_Loaded"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"
                    Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="{StaticResource ScrollTrackBrush}"
                                    CornerRadius="4"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{StaticResource ScrollThumbBrush}"
                                                        CornerRadius="4"
                                                        Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="{StaticResource ScrollThumbHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BaseBg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="HoverRect"
                                    Background="Transparent"
                                    CornerRadius="4"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HoverRect"
                                        Property="Background"
                                        Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BaseBg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="HoverCircle"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="28"
                                    Height="28"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HoverCircle"
                                        Property="Background"
                                        Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="#B8BEC6"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="14,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal"
                                    Background="Transparent">
                            <Border x:Name="CheckBorder"
                                    Width="16"
                                    Height="16"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,6,0">
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           Foreground="{StaticResource GreenBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{StaticResource SurfaceAltHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{StaticResource SurfaceAltHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"
                    Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="8,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="8,6,20,6"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextBlock.Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="Arrow"
                                               Text="▼"
                                               FontSize="8"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   AllowsTransparency="True">
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.45"/>
                    <Setter Property="Cursor"
                            Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{StaticResource SurfaceAltHoverBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="CaretBrush"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#1C1F26"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#1C1F26"/>
                            </Trigger>
                            <Trigger Property="Tag"
                                     Value="invalid">
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="0,16,0,6"/>
        </Style>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#B8BEC6"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Margin"
                    Value="14,0,0,6"/>
        </Style>

        <Style x:Key="TooltipIcon"
               TargetType="TextBlock">
            <Setter Property="Text"
                    Value="?"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Opacity"
                    Value="1"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="5,-3,0,0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="1.5"/>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTipService.IsEnabled"
                    Value="False"/>
            <Setter Property="Cursor"
                    Value="Help"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>
            <EventSetter Event="MouseEnter"
                         Handler="TooltipIcon_MouseEnter"/>
            <EventSetter Event="MouseLeave"
                         Handler="TooltipIcon_MouseLeave"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningIcon"
               TargetType="TextBlock">
            <Setter Property="Text"
                    Value="&#x26A0;"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="5,-1,0,0"/>
            <Setter Property="Foreground"
                    Value="{StaticResource RedBrush}"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="30000"/>
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay"
                    Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <Border x:Name="HeaderSection"
                            Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="10,10,0,0"
                            Padding="10,8,150,8"
                            MouseEnter="Section_MouseEnter"
                            MouseLeave="Section_MouseLeave">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Source="rune.ico"
                                   Width="43"
                                   Height="43"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RuneshapePriceChecker"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="VersionRun"
                                               Text="v0.0.0"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               Margin="6,5,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="StatusLabel"
                                           Foreground="{StaticResource GreenBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0">● Ready</TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="UpdateBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,6,110,0"
                            Padding="6,3"
                            Background="{StaticResource DarkGreenBgBrush}"
                            BorderBrush="{StaticResource GreenBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            SnapsToDevicePixels="True"
                            MouseEnter="UpdateBadge_MouseEnter"
                            MouseLeave="UpdateBadge_MouseLeave"
                            MouseLeftButtonDown="Update_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Update"
                                       Foreground="{StaticResource GreenBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="&#x2B07;"
                                       Foreground="{StaticResource GreenBrush}"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="UpdateProgressPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,6,110,0"
                                Visibility="Collapsed">
                        <Ellipse Width="16"
                                 Height="16"
                                 Stroke="{StaticResource AccentBrush}"
                                 StrokeThickness="3"
                                 StrokeDashArray="0.8 0.2"
                                 RenderTransformOrigin="0.5,0.5"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate"
                                                 Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="UpdateProgressText"
                                   Text="0%"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="SettingsBtn"
                            Width="24"
                            Height="24"
                            Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,6,36,0"
                            AutomationProperties.Name="Settings"
                            Click="Settings_Click"
                            ToolTipService.InitialShowDelay="500">
                        <TextBlock Text="&#x2699;"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Border x:Name="TestModeIndicator"
                            AutomationProperties.AutomationId="TestModeIndicator"
                            Visibility="Collapsed"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,40,6"
                            Padding="4,2"
                            BorderBrush="{StaticResource RedBrush}"
                            BorderThickness="1.5"
                            CornerRadius="3"
                            Background="#22F87171">
                        <TextBlock Text="TEST MODE"
                                   Foreground="{StaticResource RedBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                    </Border>
                    <Button x:Name="LogBtn"
                            Width="24"
                            Height="24"
                            Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,6,68,0"
                            AutomationProperties.Name="View Log"
                            Click="LogBtn_Click"
                            ToolTip="View Log"
                            ToolTipService.InitialShowDelay="500">
                        <TextBlock Text="📋"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="26"
                            Height="26"
                            Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,6,6,0"
                            AutomationProperties.Name="Close"
                            Click="Close_Click">
                        <TextBlock Text="✕"
                                   Foreground="{StaticResource RedBrush}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="DebugBtn"
                            Width="24"
                            Height="24"
                            Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            BorderThickness="0"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="Performance Metrics"
                            Click="Debug_Click"
                            ToolTip="Performance Metrics"
                            ToolTipService.InitialShowDelay="500">
                        <TextBlock Text="&#x26A1;"
                                   Foreground="{StaticResource AmberBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="1.5"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Content area (log/settings on left, debug on right when open) -->
                <Grid Grid.Row="1"
                      x:Name="ContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn"
                                          Width="*"/>
                        <ColumnDefinition x:Name="SeparatorColumn"
                                          Width="Auto"/>
                        <ColumnDefinition x:Name="DebugColumn"
                                          Width="0"
                                          MaxWidth="460"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column: warning + panels -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- OCR language pack warning bar -->
                        <Border Grid.Row="0"
                                x:Name="OcrLanguageWarning"
                                Visibility="Collapsed"
                                Background="#2A1E1E"
                                Padding="12,8">
                            <TextBlock Foreground="{StaticResource RedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap">
                            <Run Text="Language pack not installed for "/>
                            <Run x:Name="WarningLanguageName"
                                 Text="this language"
                                 FontWeight="Bold"/>
                            <Run Text=", text recognition may be inaccurate. "/>
                            <Hyperlink x:Name="InstallLanguageLink"
                                       NavigateUri="ms-settings:regionlanguage-adddisplaylanguage"
                                       Foreground="{StaticResource AccentBrush}"
                                       RequestNavigate="InstallLanguageLink_RequestNavigate">
                                <Run Text="Install the language pack here"/>
                            </Hyperlink>
                            <Run Text=" (recommended) or "/>
                            <Hyperlink x:Name="SwitchToTesseractLink"
                                       NavigateUri="switch:tesseract"
                                       Foreground="{StaticResource AccentBrush}"
                                       RequestNavigate="SwitchToTesseractLink_RequestNavigate">
                                <Run Text="switch to Tesseract"/>
                            </Hyperlink>
                            <Run Text=" (much slower)."/>
                            </TextBlock>
                        </Border>

                        <!-- Unsupported language warning bar -->
                        <Border Grid.Row="0"
                                x:Name="OcrUnsupportedLanguageWarning"
                                Visibility="Collapsed"
                                Background="#2A1E1E"
                                Padding="12,8">
                            <TextBlock Foreground="{StaticResource RedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap">
                            <Run Text="OCR disabled — "/>
                            <Run x:Name="UnsupportedLanguageName"
                                 Text="this language"
                                 FontWeight="Bold"/>
                            <Run Text=" is not supported by the app."/>
                            </TextBlock>
                        </Border>

                        <!-- Log panel -->
                        <Border Grid.Row="1"
                                x:Name="LogSection"
                                Background="Transparent"
                                CornerRadius="0,0,10,10"
                                ClipToBounds="True"
                                Visibility="Visible">
                            <Grid>
                                <ScrollViewer x:Name="LogScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="10,6,10,0"
                                              Background="Transparent">
                                    <ItemsControl x:Name="LogList"
                                                  ItemsSource="{Binding LogEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"
                                                                          MinWidth="45"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TimestampText}"
                                                               Foreground="{Binding ForegroundBrush}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="12"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding MessageText}"
                                                               Foreground="{Binding ForegroundBrush}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CountText}"
                                                               Foreground="{Binding ForegroundBrush}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="12"
                                                               Opacity="0.6"
                                                               Margin="0,0,10,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button x:Name="CopyLogButton"
                                        Width="35"
                                        Height="35"
                                        Style="{StaticResource IconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Margin="0,-1,10,0"
                                        AutomationProperties.Name="Copy Log"
                                        Click="CopyLog_Click"
                                        ToolTip="Copy log to clipboard">
                                    <TextBlock Text="&#x2398;"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="19"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Changelog panel -->
                        <Border Grid.Row="1"
                                x:Name="ChangelogSection"
                                Background="Transparent"
                                CornerRadius="0,0,10,10"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <Grid Margin="12,8,2,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <FlowDocumentScrollViewer x:Name="ChangelogViewer"
                                                          Grid.Row="0"
                                                          Grid.RowSpan="2"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Background="Transparent"
                                                          Padding="0"
                                                          Margin="0,0,0,44"/>
                                <Button Grid.Row="1"
                                        Width="100"
                                        Height="32"
                                        Background="{StaticResource GreenBtnBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Content="Got it"
                                        Click="ChangelogClose_Click"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,4"/>
                            </Grid>
                        </Border>

                        <!-- Setup prompt panel -->
                        <Border Grid.Row="1"
                                x:Name="SetupPromptSection"
                                Background="Transparent"
                                CornerRadius="0,0,10,10"
                                Visibility="Collapsed">
                            <Grid Margin="16,20">
                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            MaxWidth="380">
                                    <TextBlock Text="Open the league panel interface in the game, then press Continue to set up the overlay."
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,0,0,20"/>
                                    <Button x:Name="SetupContinueButton"
                                            Width="160"
                                            Height="36"
                                            Background="{StaticResource GreenBtnBrush}"
                                            Foreground="White"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            IsEnabled="False"
                                            Content="Continue"
                                            Click="SetupContinue_Click">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Opacity"
                                                        Value="1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled"
                                                             Value="False">
                                                        <Setter Property="Opacity"
                                                                Value="0.35"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Settings panel -->
                        <Border Grid.Row="1"
                                x:Name="SettingsSection"
                                Background="Transparent"
                                CornerRadius="0,0,10,10"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="20,6,20,12">
                                    <StackPanel>
                                        <!-- App -->
                                        <TextBlock Style="{StaticResource SectionHeader}"
                                                   Text="App"
                                                   Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Left column: stacked checkboxes -->
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="0"
                                                        Grid.RowSpan="3"
                                                        HorizontalAlignment="Left">
                                                <CheckBox x:Name="AutoUpdateCheck"
                                                          VerticalAlignment="Center"
                                                          Margin="16,0,0,0"
                                                          Checked="AutoSetting_Changed"
                                                          Unchecked="AutoSetting_Changed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Check for updates"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource TooltipIcon}"
                                                                   ToolTip="Automatically check for and download new versions from GitHub"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="40,0,0,6">
                                                    <Button Content="View Changelog"
                                                            HorizontalAlignment="Left"
                                                            Background="Transparent"
                                                            Foreground="{StaticResource AccentBrush}"
                                                            BorderThickness="0"
                                                            FontSize="12"
                                                            Cursor="Hand"
                                                            Click="ViewChangelog_Click"/>
                                                    <Ellipse x:Name="ChangelogSpinner"
                                                             Width="10"
                                                             Height="10"
                                                             Stroke="{StaticResource AccentBrush}"
                                                             StrokeThickness="2"
                                                             StrokeDashArray="0.6 0.15"
                                                             RenderTransformOrigin="0.5,0.5"
                                                             VerticalAlignment="Center"
                                                             Margin="6,0,0,0"
                                                             Visibility="Collapsed">
                                                        <Ellipse.RenderTransform>
                                                            <RotateTransform x:Name="ChangelogSpinnerRotate"
                                                                             Angle="0"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </StackPanel>
                                                <CheckBox x:Name="AlwaysOnTopCheck"
                                                          VerticalAlignment="Center"
                                                          Margin="16,0,0,4"
                                                          Checked="AlwaysOnTop_CheckedChanged"
                                                          Unchecked="AlwaysOnTop_CheckedChanged">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Always on top"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource TooltipIcon}"
                                                                   ToolTip="Keep the dashboard window above other windows at all times"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="BringToForegroundCheck"
                                                          VerticalAlignment="Center"
                                                          Margin="16,0,0,4"
                                                          Checked="AutoSetting_Changed"
                                                          Unchecked="AutoSetting_Changed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Bring to foreground"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource TooltipIcon}"
                                                                   ToolTip="Auto-focus the app window when launched or on update"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="OpenWithPoE2Check"
                                                          VerticalAlignment="Center"
                                                          Margin="16,0,0,4"
                                                          Checked="OpenWithPoE2_CheckedChanged"
                                                          Unchecked="OpenWithPoE2_CheckedChanged">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Open with PoE2"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource TooltipIcon}"
                                                                   ToolTip="Automatically launch RuneshapePriceChecker when Path of Exile 2 starts.&#10;&#10;Uses a background watcher (RPCService) that waits for PoE2 to start running in the background, then executes the app when it does. This will also start the RPCService when Windows starts, so the setting will still work even if you restart your PC."/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <CheckBox x:Name="CloseWithPoE2Check"
                                                          VerticalAlignment="Center"
                                                          Margin="16,0,0,0"
                                                          Checked="AutoSetting_Changed"
                                                          Unchecked="AutoSetting_Changed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Close with PoE2"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource TooltipIcon}"
                                                                   ToolTip="Automatically close RuneshapePriceChecker when Path of Exile 2 is no longer running"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </StackPanel>
                                            <!-- Right column: Log Level -->
                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="1"
                                                        Grid.RowSpan="3"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,6">
                                                    <TextBlock Text="Log Level"
                                                               Foreground="#B8BEC6"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource WarningIcon}"
                                                               ToolTip="Changing the log level will restart the app."/>
                                                </StackPanel>
                                                <ComboBox x:Name="LogLevelCombo"
                                                          Width="130"
                                                          HorizontalAlignment="Left"
                                                          Margin="14,0,0,0"
                                                          IsEditable="False"
                                                          SelectionChanged="ComboSetting_Changed"/>
                                                <Button x:Name="ReRunSetupBtn"
                                                        Width="120"
                                                        Height="28"
                                                        Background="{StaticResource SurfaceAltBrush}"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        FontSize="11"
                                                        Margin="14,8,0,0"
                                                        HorizontalAlignment="Left"
                                                        Click="ReRunSetup_Click">
                                                    Re-run initial setup
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- spacer -->
                                        <Border Height="12"/>

                                        <!-- Pricing -->
                                        <TextBlock Style="{StaticResource SectionHeader}"
                                                   Text="Pricing"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,6">
                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="League"
                                                               Margin="0,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource TooltipIcon}"
                                                               ToolTip="Select the Path of Exile 2 league to fetch prices for"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ComboBox x:Name="LeagueCombo"
                                                          Width="130"
                                                          HorizontalAlignment="Left"
                                                          Margin="14,0,0,0"
                                                          VerticalAlignment="Top"
                                                          IsEditable="False"
                                                          SelectionChanged="ComboSetting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,6">
                                                    <TextBlock Text="Pricing Source"
                                                               Foreground="#B8BEC6"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource TooltipIcon}"
                                                               ToolTip="poe2scout sources prices from the last 24 hours for better accuracy. poe.ninja uses only the latest listed price."
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ComboBox x:Name="PricingSourceCombo"
                                                          Width="130"
                                                          HorizontalAlignment="Left"
                                                          Margin="14,0,0,0"
                                                          VerticalAlignment="Top"
                                                          IsEditable="False"
                                                          SelectionChanged="ComboSetting_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="4"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,4">
                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="Display Currency"
                                                               Margin="0,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource TooltipIcon}"
                                                               ToolTip="Choose which currency to display prices in"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="10,8,0,0">
                                                    <CheckBox x:Name="CurrencyExaltCheck"
                                                              Content="Exalt"
                                                              VerticalAlignment="Top"
                                                              Checked="CurrencyExalt_Checked"
                                                              Unchecked="CurrencyExalt_Unchecked"/>
                                                    <CheckBox x:Name="CurrencyChaosCheck"
                                                              Content="Chaos"
                                                              VerticalAlignment="Top"
                                                              Margin="30,0,0,0"
                                                              Checked="CurrencyChaos_Checked"
                                                              Unchecked="CurrencyChaos_Unchecked"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,4">
                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="Price Color Thresholds"
                                                               Margin="0,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <CheckBox x:Name="AutoThresholdsCheck"
                                                          Margin="14,0,0,4"
                                                          Checked="AutoThresholds_Changed"
                                                          Unchecked="AutoThresholds_Changed">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Auto"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource TooltipIcon}"
                                                                   ToolTip="Automatically set color thresholds based on the highest-priced item in each scan"/>
                                                    </StackPanel>
                                                </CheckBox>
                                                <StackPanel x:Name="ThresholdBoxes"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            Margin="14,0,0,0">
                                                    <StackPanel Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock Foreground="{StaticResource RedBrush}"
                                                                       FontSize="11"
                                                                       Text="Red"
                                                                       Margin="0,0,0,2"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Style="{StaticResource TooltipIcon}"
                                                                       ToolTip="Items at or below this value appear red"/>
                                                        </StackPanel>
                                                        <TextBox x:Name="RedThresholdBox"
                                                                 Width="48"
                                                                 MaxLength="3"
                                                                 FontSize="12"
                                                                 Padding="1,1"
                                                                 HorizontalAlignment="Center"
                                                                 TextAlignment="Center"
                                                                 PreviewTextInput="ThresholdBox_PreviewTextInput"
                                                                 TextChanged="ThresholdBox_TextChanged"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock Foreground="{StaticResource AmberBrush}"
                                                                       FontSize="11"
                                                                       Text="Orange"
                                                                       Margin="0,0,0,2"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Style="{StaticResource TooltipIcon}"
                                                                       ToolTip="Items between this and the green threshold appear orange"/>
                                                        </StackPanel>
                                                        <TextBox x:Name="OrangeThresholdBox"
                                                                 Width="48"
                                                                 MaxLength="3"
                                                                 FontSize="12"
                                                                 Padding="1,1"
                                                                 HorizontalAlignment="Center"
                                                                 TextAlignment="Center"
                                                                 PreviewTextInput="ThresholdBox_PreviewTextInput"
                                                                 TextChanged="ThresholdBox_TextChanged"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock Foreground="{StaticResource GreenBrush}"
                                                                       FontSize="11"
                                                                       Text="Green"
                                                                       Margin="0,0,0,2"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Style="{StaticResource TooltipIcon}"
                                                                       ToolTip="Items at or above this value appear green"/>
                                                        </StackPanel>
                                                        <TextBox x:Name="GreenThresholdBox"
                                                                 Width="48"
                                                                 MaxLength="3"
                                                                 FontSize="12"
                                                                 Padding="1,1"
                                                                 HorizontalAlignment="Center"
                                                                 TextAlignment="Center"
                                                                 PreviewTextInput="ThresholdBox_PreviewTextInput"
                                                                 TextChanged="ThresholdBox_TextChanged"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- spacer -->
                                        <Border Height="12"/>

                                        <!-- OCR -->
                                        <TextBlock Style="{StaticResource SectionHeader}"
                                                   Text="OCR"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,6">
                                                    <TextBlock Text="OCR Backend"
                                                               Foreground="#B8BEC6"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="OcrBackendTooltip"
                                                               Style="{StaticResource TooltipIcon}"
                                                               ToolTip="Windows OCR is faster and uses less CPU, but is less accurate in some cases.&#10;&#10;It's recommended to only switch to Tesseract if Windows OCR isn't working correctly for you."/>
                                                    <TextBlock x:Name="OcrBackendWarning"
                                                               Style="{StaticResource WarningIcon}"
                                                               Foreground="{StaticResource AmberBrush}"
                                                               ToolTip="Windows OCR is faster and uses less CPU, but is less accurate in some cases.&#10;&#10;It's recommended to only switch to Tesseract if Windows OCR isn't working correctly for you."
                                                               Visibility="Collapsed"/>
                                                </StackPanel>
                                                <ComboBox x:Name="OcrBackendCombo"
                                                          Width="112"
                                                          HorizontalAlignment="Left"
                                                          Margin="14,0,0,0"
                                                          IsEditable="False"
                                                          SelectionChanged="OcrBackendCombo_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,6">
                                                    <TextBlock Text="Capture Mode"
                                                               Foreground="#B8BEC6"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="CaptureModeTooltip"
                                                               Style="{StaticResource TooltipIcon}"
                                                               ToolTip="PrintWindow: Fastest, but slightly higher CPU usage.&#10;&#10;Desktop: Slower, but lower CPU usage and compatible with lossless scaling."
                                                               Visibility="Visible"/>
                                                    <TextBlock x:Name="CaptureModeWarning"
                                                               Style="{StaticResource WarningIcon}"
                                                               ToolTip="Lossless Scaling is running — capture locked to Desktop mode for compatibility."
                                                               Visibility="Collapsed"/>
                                                </StackPanel>
                                                <ComboBox x:Name="CaptureModeCombo"
                                                          Width="112"
                                                          HorizontalAlignment="Left"
                                                          Margin="14,0,0,0"
                                                          IsEditable="False"
                                                          SelectionChanged="CaptureModeCombo_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,6">
                                                    <TextBlock Text="Scan Interval"
                                                               Foreground="#B8BEC6"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource TooltipIcon}"
                                                               ToolTip="How often to scan the game window (ms). &#10;&#10;Lower = more frequent scans, higher CPU usage.&#10;Higher = less frequent scans, lower CPU usage."/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="14,0,0,0">
                                                    <TextBox x:Name="ScanIntervalBox"
                                                             Width="52"
                                                             Height="24"
                                                             MaxLength="3"
                                                             FontSize="13"
                                                             Background="{StaticResource SurfaceAltBrush}"
                                                             Foreground="{StaticResource TextPrimary}"
                                                             BorderBrush="{StaticResource BorderBrush}"
                                                             Padding="0,1"
                                                             TextAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             PreviewTextInput="ScanIntervalBox_PreviewTextInput"
                                                             TextChanged="ScanIntervalBox_TextChanged"/>
                                                    <StackPanel Width="16"
                                                                Margin="2,0,0,0">
                                                        <RepeatButton x:Name="ScanIntervalUp"
                                                                      Width="16"
                                                                      Height="11"
                                                                      FontSize="8"
                                                                      Padding="0"
                                                                      Background="{StaticResource SurfaceAltBrush}"
                                                                      Foreground="{StaticResource TextSecondary}"
                                                                      BorderBrush="{StaticResource BorderBrush}"
                                                                      Click="ScanIntervalUp_Click">&#x25B2;</RepeatButton>
                                                        <RepeatButton x:Name="ScanIntervalDown"
                                                                      Width="16"
                                                                      Height="11"
                                                                      FontSize="8"
                                                                      Padding="0"
                                                                      Background="{StaticResource SurfaceAltBrush}"
                                                                      Foreground="{StaticResource TextSecondary}"
                                                                      BorderBrush="{StaticResource BorderBrush}"
                                                                      Click="ScanIntervalDown_Click">&#x25BC;</RepeatButton>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="DebugOverlayCheck"
                                                  Checked="DebugOverlayCheck_Changed"
                                                  Unchecked="DebugOverlayCheck_Changed">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Show debug overlay"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Style="{StaticResource TooltipIcon}"
                                                           ToolTip="Show a semi-transparent overlay marking the OCR capture region, detected item rows, and cursor position"/>
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="HideDebugOverlayCheck"
                                                  Margin="20,4,0,0"
                                                  Content="Hide when league panel not detected"
                                                  Visibility="Collapsed"
                                                  Checked="AutoSetting_Changed"
                                                  Unchecked="AutoSetting_Changed"/>
                                        <CheckBox x:Name="SaveDebugImagesCheck"
                                                  Margin="20,4,0,0"
                                                  Content="Save debug images"
                                                  Visibility="Collapsed"
                                                  Checked="AutoSetting_Changed"
                                                  Unchecked="AutoSetting_Changed"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid Grid.Row="1"
                                      Margin="24,12,24,16">
                                    <TextBlock x:Name="ValidationError"
                                               Foreground="{StaticResource RedBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text=""/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- Vertical separator between left and debug panels -->
                    <Border Grid.Column="1"
                            x:Name="DebugDivider"
                            Width="1"
                            Background="{StaticResource BorderBrush}"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed"/>

                    <!-- Right column: debug metrics panel -->
                    <Grid Grid.Column="2"
                          x:Name="DebugPanelContainer"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Debug metrics panel -->
                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                x:Name="DebugSection"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="0,0,10,10"
                                ClipToBounds="True">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="14,8,14,8"
                                              Background="Transparent">
                                    <StackPanel>

                                        <!-- ═══ OCR ENGINE (Cached / Uncached) ═══ -->
                                        <TextBlock Style="{StaticResource SectionHeader}"
                                                   Text="OCR Engine"
                                                   Margin="0,4,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left box: Cache stats -->
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource SurfaceAltBrush}"
                                                    CornerRadius="6"
                                                    Padding="10,8,10,8"
                                                    Margin="0,0,3,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
