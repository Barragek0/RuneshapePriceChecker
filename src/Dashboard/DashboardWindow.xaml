<Window x:Class="RuneshapePriceChecker.App.Dashboard.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#1A1D23"
        ResizeMode="CanResize"
        Title="RuneshapePriceChecker"
        SourceInitialized="Window_SourceInitialized"
        MinWidth="444"
        MinHeight="652"
        Width="444"
        Height="652"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#1A1D23"/>
        <SolidColorBrush x:Key="SurfaceAltBrush"
                         Color="#22262E"/>
        <SolidColorBrush x:Key="BorderBrush"
                         Color="#2E323A"/>
        <SolidColorBrush x:Key="TextPrimary"
                         Color="#E8ECF1"/>
        <SolidColorBrush x:Key="TextSecondary"
                         Color="#8A8F98"/>
        <SolidColorBrush x:Key="AccentBrush"
                         Color="#4A9EFF"/>
        <SolidColorBrush x:Key="GreenBrush"
                         Color="#34D399"/>
        <SolidColorBrush x:Key="AmberBrush"
                         Color="#FBBF24"/>
        <SolidColorBrush x:Key="RedBrush"
                         Color="#F87171"/>
        <SolidColorBrush x:Key="YellowBrush"
                         Color="#E8C547"/>
        <SolidColorBrush x:Key="ScrollThumbBrush"
                         Color="#4A4E58"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush"
                         Color="#5A5E68"/>
        <SolidColorBrush x:Key="ScrollTrackBrush"
                         Color="#1A1D23"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush"
                         Color="#22272E"/>
        <SolidColorBrush x:Key="SurfaceAltHoverBrush"
                         Color="#2A2E38"/>
        <SolidColorBrush x:Key="DarkGreenBgBrush"
                         Color="#0D3320"/>

        <Style TargetType="ToolTip">
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="250"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="3000"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"
                    Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="{StaticResource ScrollTrackBrush}"
                                    CornerRadius="4"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{StaticResource ScrollThumbBrush}"
                                                        CornerRadius="4"
                                                        Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="{StaticResource ScrollThumbHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollContentPresenter Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BaseBg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="HoverRect"
                                    Background="Transparent"
                                    CornerRadius="4"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HoverRect"
                                        Property="Background"
                                        Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BaseBg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Border x:Name="HoverCircle"
                                    Background="Transparent"
                                    CornerRadius="100"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HoverCircle"
                                        Property="Background"
                                        Value="#12FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="#B8BEC6"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Margin"
                    Value="14,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="16"
                                    Height="16"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,6,0">
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           Foreground="{StaticResource GreenBrush}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource GreenBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"
                    Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="8,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="8,6,20,6"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextBlock.Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="Arrow"
                                               Text="▼"
                                               FontSize="8"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   AllowsTransparency="True">
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{StaticResource ScrollThumbBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="CaretBrush"
                    Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="SectionHeader"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="0,16,0,6"/>
        </Style>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#B8BEC6"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Margin"
                    Value="14,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Border x:Name="HeaderSection"
                        Background="{StaticResource SurfaceAltBrush}"
                        CornerRadius="10,10,0,0"
                        Padding="10,8,108,8"
                        MouseEnter="Section_MouseEnter"
                        MouseLeave="Section_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Source="rune.ico"
                               Width="43"
                               Height="43"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RuneshapePriceChecker"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="VersionRun"
                                           Text="v0.0.0"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11"
                                           Margin="6,5,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusLabel"
                                       Foreground="{StaticResource GreenBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,0">● Ready</TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="UpdateBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,6,74,0"
                        Padding="6,3"
                        Background="{StaticResource DarkGreenBgBrush}"
                        BorderBrush="{StaticResource GreenBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        SnapsToDevicePixels="True"
                        MouseEnter="UpdateBadge_MouseEnter"
                        MouseLeave="UpdateBadge_MouseLeave"
                        MouseLeftButtonDown="Update_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Update"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock Text="&#x2B07;"
                                   Foreground="{StaticResource GreenBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="UpdateProgressPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,6,74,0"
                            Visibility="Collapsed">
                    <Ellipse Width="16"
                             Height="16"
                             Stroke="{StaticResource AccentBrush}"
                             StrokeThickness="3"
                             StrokeDashArray="0.8 0.2"
                             RenderTransformOrigin="0.5,0.5"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"
                                             Angle="0"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="UpdateProgressText"
                               Text="0%"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Width="30"
                        Height="30"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,6,38,0"
                        Click="Settings_Click">
                    <TextBlock Text="&#x2699;"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
                <Button Width="30"
                        Height="30"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,6,6,0"
                        Click="Close_Click">
                    <TextBlock Text="✕"
                               Foreground="{StaticResource RedBrush}"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Content area (log or settings) -->
            <Grid Grid.Row="1">
                <!-- Log panel -->
                <Border x:Name="LogSection"
                        Background="Transparent"
                        CornerRadius="0,0,10,10"
                        Visibility="Visible">
                    <Grid>
                        <ScrollViewer x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="10,6,10,0"
                                      Background="Transparent">
                            <ItemsControl x:Name="LogList"
                                          ItemsSource="{Binding LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"
                                                                  MinWidth="45"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimestampText}"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="12"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MessageText}"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding CountText}"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="12"
                                                       Opacity="0.6"
                                                       Margin="0,0,10,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button x:Name="CopyLogButton"
                                Width="24"
                                Height="24"
                                Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="0,5,18,0"
                                Click="CopyLog_Click"
                                ToolTip="Copy log to clipboard">
                            <TextBlock Text="&#x2398;"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Setup prompt panel -->
                <Border x:Name="SetupPromptSection"
                        Background="Transparent"
                        CornerRadius="0,0,10,10"
                        Visibility="Collapsed">
                    <Grid Margin="16,20">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    MaxWidth="380">
                            <TextBlock Text="Open the league panel interface in the game, then press Continue to set up the overlay."
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"/>
                            <Button x:Name="SetupContinueButton"
                                    Width="160"
                                    Height="36"
                                    Background="#34D399"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Content="Continue"
                                    Click="SetupContinue_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Settings panel -->
                <Border x:Name="SettingsSection"
                        Background="Transparent"
                        CornerRadius="0,0,10,10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="20,12,20,12">
                            <StackPanel>
                                <!-- App -->
                                <TextBlock Style="{StaticResource SectionHeader}"
                                           Text="App"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="DebugLoggingCheck"
                                              Grid.Column="0">Debug logging</CheckBox>
                                    <CheckBox x:Name="AutoUpdateCheck"
                                              Grid.Column="1">Check for updates</CheckBox>
                                </Grid>

                                <!-- spacer -->
                                <Border Height="12"/>

                                <!-- Pricing -->
                                <TextBlock Style="{StaticResource SectionHeader}"
                                           Text="Pricing"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="League"/>
                                        <ComboBox x:Name="LeagueCombo"
                                                  Width="130"
                                                  HorizontalAlignment="Left"
                                                  Margin="14,0,0,0"
                                                  IsEditable="False"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="Pricing Source"/>
                                        <ComboBox x:Name="PricingSourceCombo"
                                                  Width="130"
                                                  HorizontalAlignment="Left"
                                                  Margin="14,0,0,0"
                                                  IsEditable="False"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Margin="14,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="Display Currency"
                                                   Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="CurrencyChaosCheck"
                                                      Content="Chaos"
                                                      Checked="CurrencyChaos_Checked"
                                                      Unchecked="CurrencyChaos_Unchecked"/>
                                            <CheckBox x:Name="CurrencyExaltCheck"
                                                      Content="Exalt"
                                                      Margin="16,0,0,0"
                                                      Checked="CurrencyExalt_Checked"
                                                      Unchecked="CurrencyExalt_Unchecked"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="Price Color Thresholds"
                                                   Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Foreground="{StaticResource RedBrush}"
                                                           FontSize="11"
                                                           Text="Red"
                                                           Margin="0,0,0,2"
                                                           HorizontalAlignment="Center"/>
                                                <TextBox x:Name="RedThresholdBox"
                                                         Width="52"
                                                         HorizontalAlignment="Center"
                                                         TextAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Foreground="{StaticResource AmberBrush}"
                                                           FontSize="11"
                                                           Text="Orange"
                                                           Margin="0,0,0,2"
                                                           HorizontalAlignment="Center"/>
                                                <TextBox x:Name="OrangeThresholdBox"
                                                         Width="52"
                                                         HorizontalAlignment="Center"
                                                         TextAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource GreenBrush}"
                                                           FontSize="11"
                                                           Text="Green"
                                                           Margin="0,0,0,2"
                                                           HorizontalAlignment="Center"/>
                                                <TextBox x:Name="GreenThresholdBox"
                                                         Width="52"
                                                         HorizontalAlignment="Center"
                                                         TextAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- spacer -->
                                <Border Height="12"/>

                                <!-- OCR -->
                                <TextBlock Style="{StaticResource SectionHeader}"
                                           Text="OCR"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}"
                                                   Text="Game Language"/>
                                        <ComboBox x:Name="LanguageCombo"
                                                  Width="130"
                                                  HorizontalAlignment="Left"
                                                  Margin="14,0,0,0"
                                                  IsEditable="False"/>
                                    </StackPanel>
                                    <Button x:Name="ReRunSetupBtn"
                                            Grid.Column="1"
                                            Width="150"
                                            Height="28"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            Foreground="{StaticResource AccentBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            FontSize="11"
                                            Margin="16,16,12,0"
                                            VerticalAlignment="Bottom"
                                            Click="ReRunSetup_Click"
                                            ToolTip="Re-run the initial OCR region setup wizard">
                                        Re-run initial setup
                                    </Button>
                                </Grid>

                                <CheckBox x:Name="DebugOverlayCheck">Show debug overlay</CheckBox>
                                <CheckBox x:Name="HideDebugOverlayCheck">Hide debug overlay when panel not detected</CheckBox>
                                <CheckBox x:Name="SaveDebugImagesCheck">Save debug images</CheckBox>
                                <CheckBox x:Name="ShowPricingOverlayCheck">Show pricing overlay</CheckBox>
                                <CheckBox x:Name="ShowBannerCheck">Show unpriced item banner</CheckBox>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1"
                              Margin="24,12,24,16">
                            <TextBlock x:Name="ValidationError"
                                       Foreground="{StaticResource RedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Text=""/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Width="80"
                                        Height="32"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        Foreground="{StaticResource RedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        FontSize="12"
                                        Margin="0,0,8,0"
                                        Click="SettingsCancel_Click">Cancel</Button>
                                <Button x:Name="SaveBtn"
                                        Width="80"
                                        Height="32"
                                        Background="{StaticResource GreenBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="12"
