{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Publish (Release)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "publish",
                "RuneshapePriceChecker.csproj",
                "-c",
                "Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Publishes RuneshapePriceChecker as a single-file Release executable and packages the release zip."
        },
        {
            "label": "Run with Hot Reload",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "RuneshapePriceChecker.csproj",
                "run",
                "--OCR:SaveDebugImages=true",
                "--OCR:DebugOverlay=false",
                "--OCR:HideDebugOverlayWhenInterfaceNotDetected=true",
                "--App:DebugLogging=true",
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile",
            "detail": "Runs RuneshapePriceChecker with .NET Hot Reload for development."
        }
    ]
}