{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Publish (Release)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "publish",
                "RuneshapePriceChecker.csproj",
                "-c",
                "Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Publishes RuneshapePriceChecker as a trimmed compressed single-file Release executable, runs tests, and packages the release zip + installer."
        },
        {
            "label": "Run with Hot Reload",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "RuneshapePriceChecker.csproj",
                "--",
                "run",
                "-p:UseRunOutput=true"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile",
            "detail": "Runs RuneshapePriceChecker with .NET Hot Reload for development."
        },
        {
            "label": "Start Update Test Servers",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "scripts\\start-update-test-servers.ps1"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "detail": "Starts the HTTP test server and TLS proxy for local auto-update testing."
        },
        {
            "label": "Stop Update Test Servers",
            "type": "shell",
            "command": "taskkill /F /IM UpdateTestServer.exe & taskkill /F /IM TlsProxy.exe",
            "problemMatcher": [],
            "detail": "Stops the HTTP test server and TLS proxy."
        },
        {
            "label": "Run Performance Comparison",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "scripts\\monitor-performance.ps1"
            ],
            "group": "test",
            "problemMatcher": [],
            "detail": "Runs 3-way OCR backend comparison: v1.0.0 baseline vs v1.0.1 tesseract vs v1.0.1 windows (9 runs, ~3 min). Requires PoE2 running."
        },
        {
            "label": "Run Pre-Release Tests",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "tests\\pre-release-tests.ps1",
                "-All"
            ],
            "group": "test",
            "problemMatcher": [],
            "detail": "Runs the full pre-release test suite (80 tests). Output is clean PASS/FAIL lines."
        }
    ]
}