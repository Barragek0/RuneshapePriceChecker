<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CA1873;CA2101</NoWarn>
    <AssemblyName>RuneshapePriceChecker</AssemblyName>
    <ApplicationIcon>img\rune.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RuneshapePriceChecker.Tests" />
    <InternalsVisibleTo Include="RuneshapePriceChecker.Dashboard" />
    <InternalsVisibleTo Include="RuneshapePriceChecker.Dashboard" />
    <InternalsVisibleTo Include="CrashSimulator" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="img\example.png" Condition="Exists('img\example.png')" />
    <EmbeddedResource Include="src\Pricing\translations.json" Visible="false" Link="tesseract\translations.json" />
    <EmbeddedResource Include="ocr\translations\fra.ndjson" Visible="false" Link="translations\fra.ndjson" />
    <EmbeddedResource Include="ocr\translations\deu.ndjson" Visible="false" Link="translations\deu.ndjson" />
    <EmbeddedResource Include="ocr\translations\spa.ndjson" Visible="false" Link="translations\spa.ndjson" />
    <EmbeddedResource Include="ocr\translations\por.ndjson" Visible="false" Link="translations\por.ndjson" />
    <EmbeddedResource Include="ocr\translations\rus.ndjson" Visible="false" Link="translations\rus.ndjson" />
    <EmbeddedResource Include="ocr\translations\kor.ndjson" Visible="false" Link="translations\kor.ndjson" />
    <EmbeddedResource Include="ocr\translations\chi_tra.ndjson" Visible="false" Link="translations\chi_tra.ndjson" />
    <EmbeddedResource Include="ocr\unique-category-map.json" Visible="false" />
  </ItemGroup>

  <!-- Pre-build: check for updated translation files from Exiled Exchange 2 -->
  <Target Name="UpdateTranslations" BeforeTargets="BeforeBuild" Condition="'$(GITHUB_ACTIONS)' != 'true'">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;scripts\update-translations.ps1&quot;" ContinueOnError="true" />
  </Target>

  <!-- Publish: trimmed self-contained (Release only, Debug uses framework-dependent for hot reload) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StartupHookSupport>false</StartupHookSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)\obj\Release\publish\</PublishDir>
  </PropertyGroup>

  <!-- NuGet -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
    <PackageReference Include="StructLinq" Version="0.19.1" />
    <PackageReference Include="System.Management" Version="9.0.3" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- References -->
  <ItemGroup>
    <ProjectReference Include="src\Dashboard\Dashboard.csproj" />
  </ItemGroup>

  <!-- Exclude non-app source from compilation -->
  <ItemGroup>
    <Compile Remove="scripts\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="src\Updater\**\*.cs" />
    <Compile Remove="src\Dashboard\**\*.cs" />
  </ItemGroup>

  <!-- Kill any running RuneshapePriceChecker before build to avoid file locks -->
  <Target Name="KillRunningApp" BeforeTargets="BeforeBuild;BeforeRebuild">
    <Exec Command="powershell -NoProfile -Command &quot;Get-Process RuneshapePriceChecker -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; exit 0&quot;" />
  </Target>

  <!-- Tesseract: embed traineddata + native DLLs -->
  <Target Name="EnsureTessData" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <TessDataFile>$(MSBuildProjectDirectory)\ocr\tesseract\eng.traineddata</TessDataFile>
      <TessNativeDir>$(MSBuildProjectDirectory)\native</TessNativeDir>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\ocr\tesseract" Condition="!Exists('$(MSBuildProjectDirectory)\ocr\tesseract')" />
    <Exec Command="powershell -NoProfile -Command if (-not (Test-Path '$(TessDataFile)')) { Write-Host 'Downloading eng.traineddata (best)...'; Invoke-WebRequest -Uri 'https://github.com/tesseract-ocr/tessdata_best/raw/main/eng.traineddata' -OutFile '$(TessDataFile)' }" Condition="!Exists('$(TessDataFile)')" />
    <ItemGroup>
      <EmbeddedResource Include="$(TessDataFile)" Visible="false" Link="ocr\tesseract\eng.traineddata" />
    </ItemGroup>
    <PropertyGroup>
      <_TessPkgNativeDir>$(NuGetPackageRoot)\tesseract\5.2.0\x64</_TessPkgNativeDir>
    </PropertyGroup>
    <MakeDir Directories="$(TessNativeDir)" Condition="!Exists('$(TessNativeDir)')" />
    <Copy SourceFiles="$(_TessPkgNativeDir)\tesseract50.dll;$(_TessPkgNativeDir)\leptonica-1.82.0.dll" DestinationFolder="$(TessNativeDir)" Condition="Exists('$(_TessPkgNativeDir)\tesseract50.dll')" />
    <ItemGroup>
      <EmbeddedResource Include="$(TessNativeDir)\tesseract50.dll" Visible="false" Link="native\tesseract50.dll" Condition="Exists('$(TessNativeDir)\tesseract50.dll')" />
      <EmbeddedResource Include="$(TessNativeDir)\leptonica-1.82.0.dll" Visible="false" Link="native\leptonica-1.82.0.dll" Condition="Exists('$(TessNativeDir)\leptonica-1.82.0.dll')" />
    </ItemGroup>
  </Target>

  <!-- Native crash handler DLL — copy to output so DllImport resolves it -->
  <ItemGroup>
    <Content Include="$(MSBuildProjectDirectory)\native\NativeCrashHandler.dll" Condition="Exists('$(MSBuildProjectDirectory)\native\NativeCrashHandler.dll')">
      <Link>NativeCrashHandler.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <!-- Hot reload: use separate output directory so bin/Debug is never locked -->
  <PropertyGroup Condition="'$(UseRunOutput)' == 'true'">
    <OutputPath>bin\run\</OutputPath>
    <IntermediateOutputPath>obj\run\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Release pipeline: Publish - Test - Zip - Installer -->
  <!--
    dotnet test is used instead of dotnet build + separate dotnet test run because
    publish already compiles the main project.  dotnet test's implicit build
    detects the main project is up to date and only compiles the test project,
    saving ~3-5 seconds of redundant MSBuild overhead.
  -->
  <Target Name="Test" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(SkipTest)' != 'true'">
    <Exec Command="dotnet test tests\Tests.csproj -c Release --nologo --verbosity normal -m:4 --filter &quot;Category!=NativeCrash&quot;" />
  </Target>

  <Target Name="Zip" AfterTargets="Test" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ZipDir>$(MSBuildProjectDirectory)\bin\Release</_ZipDir>
      <_PublishDir>$(MSBuildProjectDirectory)\obj\Release\publish</_PublishDir>
    </PropertyGroup>
    <!-- Close 7-Zip if open — it locks the destination zip file -->
    <Exec Command="powershell -NoProfile -Command &quot;Get-Process 7zFM,7zG,7z -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue&quot;" ContinueOnError="WarnAndContinue" />
    <MakeDir Directories="$(_ZipDir)" Condition="!Exists('$(_ZipDir)')" />
    <Exec Command="powershell -NoProfile -Command Compress-Archive -Path '$(_PublishDir)\RuneshapePriceChecker.exe', '$(MSBuildProjectDirectory)\README.md' -DestinationPath '$(_ZipDir)\RuneshapePriceChecker.zip' -Force" />
    <Message Text="Created $(_ZipDir)\RuneshapePriceChecker.zip" Importance="high" />
  </Target>

  <Target Name="Installer" AfterTargets="Zip" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_IsccPath></_IsccPath>
      <_IsccPath Condition="Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe')">C:\Program Files (x86)\Inno Setup 6\ISCC.exe</_IsccPath>
    </PropertyGroup>

    <Exec Condition="'$(_IsccPath)' != ''" Command="&quot;$(_IsccPath)&quot; &quot;$(MSBuildProjectDirectory)\installer.iss&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Message Condition="'$(_IsccPath)' == ''" Text="Inno Setup 6 not found. Skipping installer. Install from https://jrsoftware.org/isinfo.php" Importance="High" />
  </Target>

</Project>
