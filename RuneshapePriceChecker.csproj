<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RuneshapePriceChecker</AssemblyName>
    <ApplicationIcon>img\rune.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>$(MSBuildProjectDirectory)\obj\Release\publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="scripts\**\*.cs" />
    <Compile Remove="src\Updater\**\*.cs" />
  </ItemGroup>

  <Target Name="RemoveLegacyAppSettingsFromOutput" AfterTargets="Build;Publish">
    <Delete Files="$(TargetDir)appsettings.json;$(TargetDir)src\appsettings.json" ContinueOnError="true" />
  </Target>

  <Target Name="CopyUpdaterToOutput" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\src\Updater\Updater.csproj&quot; -c $(Configuration) --nologo" />
    <ItemGroup>
      <_UpdaterOutputFiles Include="$(MSBuildProjectDirectory)\src\Updater\bin\$(Configuration)\net8.0\*" Exclude="$(MSBuildProjectDirectory)\src\Updater\bin\$(Configuration)\net8.0\*.pdb" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_UpdaterOutputFiles)"
      DestinationFolder="$(TargetDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PackageReleaseZip" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_UpdaterPublishDir>$(MSBuildProjectDirectory)\obj\Release\updater-publish\</_UpdaterPublishDir>
      <ReleaseZipPath>$(BaseOutputPath)$(Configuration)\RuneshapePriceChecker.zip</ReleaseZipPath>
      <ReleaseZipStageDir>$(BaseIntermediateOutputPath)$(Configuration)\zip-stage\</ReleaseZipStageDir>
    </PropertyGroup>

    <ItemGroup>
      <_PublishFiles Include="$(PublishDir)*" Exclude="$(PublishDir)*.pdb" />
    </ItemGroup>

    <MakeDir Directories="$(BaseOutputPath)$(Configuration)" />
    <RemoveDir Directories="$(ReleaseZipStageDir)" ContinueOnError="true" />
    <MakeDir Directories="$(ReleaseZipStageDir)" />

    <Copy SourceFiles="@(_PublishFiles)" DestinationFolder="$(ReleaseZipStageDir)" />

    <Exec Command="dotnet publish src\Updater\Updater.csproj -c Release --nologo &quot;-p:PublishDir=$(_UpdaterPublishDir)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <_UpdaterZipFiles Include="$(_UpdaterPublishDir)Update.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_UpdaterZipFiles)" DestinationFolder="$(ReleaseZipStageDir)" />

    <Delete Files="$(ReleaseZipPath)" ContinueOnError="true" />
    <ZipDirectory SourceDirectory="$(ReleaseZipStageDir)" DestinationFile="$(ReleaseZipPath)" Overwrite="true" ContinueOnError="WarnAndContinue" />
    <RemoveDir Directories="$(ReleaseZipStageDir)" ContinueOnError="true" />
  </Target>
</Project>
