<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RuneshapePriceChecker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="src\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Watch Include="src\appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="scripts\**\*.cs" />
  </ItemGroup>

  <Target Name="PackageReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <ReleaseZipPath>$(BaseOutputPath)$(Configuration)\RuneshapePriceChecker.zip</ReleaseZipPath>
      <TargetDirTrimmed>$([System.String]::Copy('$(TargetDir)').TrimEnd('\\'))</TargetDirTrimmed>
      <TargetDirContentsPattern>$([System.String]::Concat('$(TargetDirTrimmed)', '\\*'))</TargetDirContentsPattern>
    </PropertyGroup>

    <MakeDir Directories="$(BaseOutputPath)$(Configuration)" />
    <Delete Files="$(ReleaseZipPath)" ContinueOnError="true" />
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(TargetDirContentsPattern)' -DestinationPath '$(ReleaseZipPath)' -CompressionLevel Optimal&quot;" />
  </Target>
</Project>
