<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AssemblyName>RuneshapePriceChecker</AssemblyName>
    <ApplicationIcon>img\rune.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="img\example.png" Condition="Exists('img\example.png')" />
  </ItemGroup>

  <!-- Publish: trimmed self-contained (Release only, Debug uses framework-dependent for hot reload) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StartupHookSupport>false</StartupHookSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildProjectDirectory)\obj\Release\publish\</PublishDir>
  </PropertyGroup>

  <!-- NuGet -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!-- References -->
  <ItemGroup>
    <ProjectReference Include="src\Dashboard\Dashboard.csproj" />
  </ItemGroup>

  <!-- Exclude non-app source from compilation -->
  <ItemGroup>
    <Compile Remove="scripts\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="src\Updater\**\*.cs" />
    <Compile Remove="src\Dashboard\**\*.cs" />
  </ItemGroup>

  <!-- Tesseract: embed traineddata + native DLLs -->
  <Target Name="EnsureTessData" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <TessDataFile>$(MSBuildProjectDirectory)\tesseract\eng.traineddata</TessDataFile>
      <TessNativeDir>$(MSBuildProjectDirectory)\native</TessNativeDir>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\tesseract" Condition="!Exists('$(MSBuildProjectDirectory)\tesseract')" />
    <Exec Command="powershell -NoProfile -Command if (-not (Test-Path '$(TessDataFile)')) { Write-Host 'Downloading eng.traineddata (best)...'; Invoke-WebRequest -Uri 'https://github.com/tesseract-ocr/tessdata_best/raw/main/eng.traineddata' -OutFile '$(TessDataFile)' }" Condition="!Exists('$(TessDataFile)')" />
    <ItemGroup>
      <EmbeddedResource Include="$(TessDataFile)" Visible="false" Link="tesseract\eng.traineddata" />
    </ItemGroup>
    <PropertyGroup>
      <_TessPkgNativeDir>$(NuGetPackageRoot)\tesseract\5.2.0\x64</_TessPkgNativeDir>
    </PropertyGroup>
    <MakeDir Directories="$(TessNativeDir)" Condition="!Exists('$(TessNativeDir)')" />
    <Copy SourceFiles="$(_TessPkgNativeDir)\tesseract50.dll;$(_TessPkgNativeDir)\leptonica-1.82.0.dll" DestinationFolder="$(TessNativeDir)" Condition="Exists('$(_TessPkgNativeDir)\tesseract50.dll')" />
    <ItemGroup>
      <EmbeddedResource Include="$(TessNativeDir)\tesseract50.dll" Visible="false" Link="native\tesseract50.dll" Condition="Exists('$(TessNativeDir)\tesseract50.dll')" />
      <EmbeddedResource Include="$(TessNativeDir)\leptonica-1.82.0.dll" Visible="false" Link="native\leptonica-1.82.0.dll" Condition="Exists('$(TessNativeDir)\leptonica-1.82.0.dll')" />
    </ItemGroup>
  </Target>

  <!-- Hot reload: use separate output directory so bin/Debug is never locked -->
  <PropertyGroup Condition="'$(UseRunOutput)' == 'true'">
    <OutputPath>bin\run\</OutputPath>
    <IntermediateOutputPath>obj\run\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Release pipeline: Build -> Test -> Zip -> Installer -->

  <Target Name="Test" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_TestLogFile>$(IntermediateOutputPath)test-output.log</_TestLogFile>
    </PropertyGroup>
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tests\run-all.ps1&quot; 1&gt;&quot;$(_TestLogFile)&quot; 2&gt;&amp;1" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_TestExitCode" />
    </Exec>
    <Exec Command="powershell -ExecutionPolicy Bypass -Command Get-Content '$(_TestLogFile)'" Condition="$(_TestExitCode) == 0" />
    <ReadLinesFromFile File="$(_TestLogFile)" Condition="Exists('$(_TestLogFile)') and $(_TestExitCode) != 0">
      <Output TaskParameter="Lines" ItemName="_TestErrLines" />
    </ReadLinesFromFile>
    <Error Condition="$(_TestExitCode) != 0" Text="@(_TestErrLines, '%0a')" />
  </Target>

  <Target Name="Zip" AfterTargets="Test" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_UpdaterPublishDir>$(MSBuildProjectDirectory)\obj\Release\updater-publish\</_UpdaterPublishDir>
      <ReleaseZipPath>$(BaseOutputPath)$(Configuration)\RuneshapePriceChecker.zip</ReleaseZipPath>
      <ReleaseZipStageDir>$(BaseIntermediateOutputPath)$(Configuration)\zip-stage\</ReleaseZipStageDir>
    </PropertyGroup>

    <ItemGroup>
      <_PublishFiles Include="$(PublishDir)*.exe" />
    </ItemGroup>

    <MakeDir Directories="$(BaseOutputPath)$(Configuration)" />
    <RemoveDir Directories="$(ReleaseZipStageDir)" ContinueOnError="true" />
    <MakeDir Directories="$(ReleaseZipStageDir)" />

    <Copy SourceFiles="@(_PublishFiles)" DestinationFolder="$(ReleaseZipStageDir)" />

    <Exec Command="dotnet publish src\Updater\Updater.csproj -c Release --nologo &quot;-p:PublishDir=$(_UpdaterPublishDir)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <_UpdaterZipFiles Include="$(_UpdaterPublishDir)Update.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_UpdaterZipFiles)" DestinationFolder="$(ReleaseZipStageDir)" />

    <Copy SourceFiles="README.md" DestinationFiles="$(ReleaseZipStageDir)README.txt" />
    <Copy SourceFiles="ADDING_A_RESOLUTION.md" DestinationFiles="$(ReleaseZipStageDir)ADDING_A_RESOLUTION.txt" />

    <Delete Files="$(ReleaseZipPath)" ContinueOnError="true" />
    <ZipDirectory SourceDirectory="$(ReleaseZipStageDir)" DestinationFile="$(ReleaseZipPath)" Overwrite="true" ContinueOnError="WarnAndContinue" />
    <RemoveDir Directories="$(ReleaseZipStageDir)" ContinueOnError="true" />
  </Target>

  <Target Name="Installer" AfterTargets="Zip" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_IsccPath></_IsccPath>
      <_IsccPath Condition="Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe')">C:\Program Files (x86)\Inno Setup 6\ISCC.exe</_IsccPath>
    </PropertyGroup>

    <Exec Condition="'$(_IsccPath)' != ''"
          Command="&quot;$(_IsccPath)&quot; &quot;$(MSBuildProjectDirectory)\installer.iss&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Message Condition="'$(_IsccPath)' == ''"
             Text="Inno Setup 6 not found. Skipping installer. Install from https://jrsoftware.org/isinfo.php" Importance="High" />
  </Target>

</Project>
