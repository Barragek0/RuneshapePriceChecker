<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RuneshapePriceChecker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="src\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Watch Include="src\appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="scripts\**\*.cs" />
  </ItemGroup>

  <Target Name="PackageReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <ReleaseZipPath>$(BaseOutputPath)$(Configuration)\RuneshapePriceChecker.zip</ReleaseZipPath>
      <ReleaseZipStageDir>$(BaseIntermediateOutputPath)$(Configuration)\zip-stage\</ReleaseZipStageDir>
      <ReleaseZipStageContentsPattern>$([System.String]::Concat('$(ReleaseZipStageDir)', '*'))</ReleaseZipStageContentsPattern>
      <ReleaseZipStageAppSettingsPath>$(ReleaseZipStageDir)src\appsettings.json</ReleaseZipStageAppSettingsPath>
      <ReleaseDefaultAppSettingsPath>$(MSBuildProjectDirectory)\src\appsettings.release.json</ReleaseDefaultAppSettingsPath>
    </PropertyGroup>

    <ItemGroup>
      <_ReleaseZipStageSourceFiles Include="$(TargetDir)**\*" />
    </ItemGroup>

    <MakeDir Directories="$(BaseOutputPath)$(Configuration)" />
    <RemoveDir Directories="$(ReleaseZipStageDir)" ContinueOnError="true" />
    <MakeDir Directories="$(ReleaseZipStageDir)" />
    <Copy SourceFiles="@(_ReleaseZipStageSourceFiles)" DestinationFiles="@(_ReleaseZipStageSourceFiles->'$(ReleaseZipStageDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ReleaseZipStageAppSettingsPath)'))" />
    <Copy SourceFiles="$(ReleaseDefaultAppSettingsPath)" DestinationFiles="$(ReleaseZipStageAppSettingsPath)" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(ReleaseZipPath)" ContinueOnError="true" />
    <ZipDirectory
      SourceDirectory="$(ReleaseZipStageDir)"
      DestinationFile="$(ReleaseZipPath)"
      Overwrite="true"
      ContinueOnError="WarnAndContinue" />
    <RemoveDir Directories="$(ReleaseZipStageDir)" ContinueOnError="true" />
  </Target>
</Project>
