[*.cs]

# Code style: surface all IDE diagnostics as build warnings
dotnet_diagnostic.IDE*.severity = warning

# Exceptions: rules we don't want
dotnet_diagnostic.IDE0130.severity = none  # Namespace does not match folder structure
dotnet_diagnostic.IDE0160.severity = none  # Convert to block scoped namespace

# DashboardViewModel uses JSON keys that don't match property names by design
[src/Dashboard/DashboardViewModel.cs]
dotnet_diagnostic.CA1507.severity = none
