[*.cs]

# Code style: surface IDE diagnostics as build warnings
csharp_prefer_braces = false                  # Omit braces around single-statement blocks

dotnet_diagnostic.IDE0001.severity = warning  # Simplify name
dotnet_diagnostic.IDE0002.severity = warning  # Simplify member access
dotnet_diagnostic.IDE0003.severity = warning  # Remove 'this' qualification
dotnet_diagnostic.IDE0004.severity = warning  # Remove unnecessary cast
dotnet_diagnostic.IDE0005.severity = warning  # Remove unnecessary usings
dotnet_diagnostic.IDE0007.severity = warning  # Use 'var' instead of explicit type
dotnet_diagnostic.IDE0010.severity = warning  # Add missing cases to switch statement
dotnet_diagnostic.IDE0011.severity = warning  # Remove unnecessary braces
dotnet_diagnostic.IDE0016.severity = warning  # Use 'throw' expression
dotnet_diagnostic.IDE0017.severity = warning  # Simplify object initialization
dotnet_diagnostic.IDE0018.severity = warning  # Simplify variable declaration
dotnet_diagnostic.IDE0019.severity = warning  # Use pattern matching
dotnet_diagnostic.IDE0020.severity = warning  # Use pattern matching
dotnet_diagnostic.IDE0021.severity = warning  # Expression body for constructors
dotnet_diagnostic.IDE0022.severity = none     # Use block body for methods (contradicts IDE0021; expression bodies are preferred for simple methods)
dotnet_diagnostic.IDE0023.severity = warning  # Expression body for operators
dotnet_diagnostic.IDE0024.severity = warning  # Expression body for operators
dotnet_diagnostic.IDE0025.severity = warning  # Expression body for properties
dotnet_diagnostic.IDE0026.severity = warning  # Expression body for indexers
dotnet_diagnostic.IDE0027.severity = warning  # Expression body for accessors
dotnet_diagnostic.IDE0028.severity = warning  # Simplify collection initialization
dotnet_diagnostic.IDE0029.severity = warning  # Simplify conditional expression
dotnet_diagnostic.IDE0030.severity = warning  # Simplify null check
dotnet_diagnostic.IDE0031.severity = warning  # Use null propagation
dotnet_diagnostic.IDE0032.severity = warning  # Use auto-implemented properties
dotnet_diagnostic.IDE0033.severity = warning  # Use explicitly provided tuple name
dotnet_diagnostic.IDE0034.severity = warning  # Simplify 'default' expression
dotnet_diagnostic.IDE0035.severity = warning  # Remove unreachable code
dotnet_diagnostic.IDE0036.severity = warning  # Order modifiers
dotnet_diagnostic.IDE0037.severity = warning  # Use inferred member name
dotnet_diagnostic.IDE0038.severity = warning  # Use pattern matching to avoid 'is' check followed by cast
dotnet_diagnostic.IDE0039.severity = warning  # Use local function instead of lambda
dotnet_diagnostic.IDE0040.severity = warning  # Add accessibility modifiers
dotnet_diagnostic.IDE0041.severity = warning  # Use 'is null' check
dotnet_diagnostic.IDE0042.severity = warning  # Deconstruct variable declaration
dotnet_diagnostic.IDE0044.severity = warning  # Make field readonly
dotnet_diagnostic.IDE0047.severity = warning  # Remove unnecessary parentheses
dotnet_diagnostic.IDE0048.severity = warning  # Add accessibility modifiers
dotnet_diagnostic.IDE0051.severity = warning  # Remove unused private members
dotnet_diagnostic.IDE0052.severity = warning  # Remove unread private members
dotnet_diagnostic.IDE0055.severity = warning  # Fix formatting
dotnet_diagnostic.IDE0056.severity = warning  # Use index operator
dotnet_diagnostic.IDE0057.severity = warning  # Use range operator
dotnet_diagnostic.IDE0058.severity = warning  # Remove unused expression value
dotnet_diagnostic.IDE0059.severity = warning  # Remove unnecessary value assignment
dotnet_diagnostic.IDE0061.severity = warning  # Expression body for local functions
dotnet_diagnostic.IDE0062.severity = warning  # Make local function static
dotnet_diagnostic.IDE0063.severity = warning  # Use 'using' statement
dotnet_diagnostic.IDE0065.severity = warning  # Place using directives outside namespace
dotnet_diagnostic.IDE0066.severity = warning  # Use 'switch' expression
dotnet_diagnostic.IDE0067.severity = warning  # Dispose objects before losing scope
dotnet_diagnostic.IDE0068.severity = warning  # Use recommended dispose pattern
dotnet_diagnostic.IDE0069.severity = warning  # Disposable types should have finalizer
dotnet_diagnostic.IDE0070.severity = warning  # Use 'System.HashCode.Combine'
dotnet_diagnostic.IDE0071.severity = warning  # Simplify interpolation
dotnet_diagnostic.IDE0072.severity = warning  # Add missing cases to switch expression
dotnet_diagnostic.IDE0074.severity = warning  # Use coalesce expression
dotnet_diagnostic.IDE0075.severity = warning  # Simplify conditional expression
dotnet_diagnostic.IDE0076.severity = warning  # Remove unnecessary 'SuppressMessageAttribute'
dotnet_diagnostic.IDE0077.severity = warning  # Avoid legacy format target in 'SuppressMessageAttribute'
dotnet_diagnostic.IDE0078.severity = warning  # Use pattern matching
dotnet_diagnostic.IDE0079.severity = warning  # Remove unnecessary suppression
dotnet_diagnostic.IDE0080.severity = warning  # Remove unnecessary suppression
dotnet_diagnostic.IDE0082.severity = warning  # Convert typeof to nameof
dotnet_diagnostic.IDE0090.severity = warning  # Use 'new(...)'
dotnet_diagnostic.IDE0091.severity = warning  # Use 'Equals' instead of 'ReferenceEquals'
dotnet_diagnostic.IDE0100.severity = warning  # Remove unnecessary equality operator
dotnet_diagnostic.IDE0101.severity = warning  # Simplify object initialization
dotnet_diagnostic.IDE0110.severity = warning  # Remove unnecessary discards
dotnet_diagnostic.IDE0120.severity = warning  # Simplify LINQ expression
dotnet_diagnostic.IDE0140.severity = warning  # Simplify object creation
dotnet_diagnostic.IDE0150.severity = warning  # Use null check pattern
dotnet_diagnostic.IDE0161.severity = warning  # Use file-scoped namespace
dotnet_diagnostic.IDE0170.severity = warning  # Use property pattern
dotnet_diagnostic.IDE0180.severity = warning  # Use tuple to swap values
dotnet_diagnostic.IDE0190.severity = warning  # Use null coalescing assignment
dotnet_diagnostic.IDE0200.severity = warning  # Use lambda expression
dotnet_diagnostic.IDE0210.severity = warning  # Use tuple conversion
dotnet_diagnostic.IDE0211.severity = warning  # Use expression body for local functions
dotnet_diagnostic.IDE0220.severity = warning  # Use explicit tuple name
dotnet_diagnostic.IDE0230.severity = warning  # Use UTF-8 string literal
dotnet_diagnostic.IDE0240.severity = warning  # Use nullable annotation
dotnet_diagnostic.IDE0250.severity = warning  # Make struct 'readonly'
dotnet_diagnostic.IDE0251.severity = warning  # Make member 'readonly'
dotnet_diagnostic.IDE0260.severity = warning  # Use pattern matching to avoid null check
dotnet_diagnostic.IDE0270.severity = warning  # Use coalesce expression for null check
dotnet_diagnostic.IDE0280.severity = warning  # Use 'nameof'
dotnet_diagnostic.IDE0290.severity = warning  # Use primary constructor
dotnet_diagnostic.IDE0300.severity = warning  # Use collection expression
dotnet_diagnostic.IDE0301.severity = warning  # Use collection expression
dotnet_diagnostic.IDE0302.severity = warning  # Use collection expression
dotnet_diagnostic.IDE0303.severity = warning  # Use collection expression
dotnet_diagnostic.IDE0304.severity = warning  # Use collection expression
dotnet_diagnostic.IDE0305.severity = warning  # Use collection expression
dotnet_diagnostic.IDE1005.severity = warning  # Use conditional delegate call
dotnet_diagnostic.IDE2000.severity = warning  # Use blank line to separate statements
dotnet_diagnostic.IDE2001.severity = warning  # Use embedded statement

# CA diagnostics

dotnet_diagnostic.CA1001.severity = warning   # Types that own disposable fields should be disposable
dotnet_diagnostic.CA1032.severity = warning   # Implement standard exception constructors
dotnet_diagnostic.CA1034.severity = warning   # Nested types should not be visible
dotnet_diagnostic.CA1052.severity = warning   # Static holder types should be static or NotInheritable
dotnet_diagnostic.CA1062.severity = warning   # Validate public method arguments
dotnet_diagnostic.CA1065.severity = warning   # Do not raise exceptions in unexpected locations
dotnet_diagnostic.CA1068.severity = warning   # CancellationToken parameters must come last
dotnet_diagnostic.CA1069.severity = warning   # Enum values should not be duplicated
dotnet_diagnostic.CA1070.severity = warning   # Do not declare event fields as virtual
dotnet_diagnostic.CA1310.severity = warning   # Specify StringComparison
dotnet_diagnostic.CA1401.severity = warning   # P/Invokes should not be visible
dotnet_diagnostic.CA1507.severity = warning   # Use nameof in place of string literal (except DashboardViewModel — see per-file override)
dotnet_diagnostic.CA1805.severity = warning   # Do not initialize unnecessarily
dotnet_diagnostic.CA1806.severity = warning   # Do not ignore method results
dotnet_diagnostic.CA1822.severity = warning   # Mark members as static
dotnet_diagnostic.CA1825.severity = warning   # Avoid zero-length array allocations
dotnet_diagnostic.CA1827.severity = warning   # Do not use Count() when Any() can be used
dotnet_diagnostic.CA1828.severity = warning   # Do not use CountAsync() when AnyAsync() can be used
dotnet_diagnostic.CA1829.severity = warning   # Use Length/Count property instead of Count()
dotnet_diagnostic.CA1830.severity = warning   # Prefer strongly-typed Append/Insert for StringBuilder
dotnet_diagnostic.CA1833.severity = warning   # Use AsSpan/AsMemory instead of Range-based indexers
dotnet_diagnostic.CA1834.severity = warning   # Use StringBuilder.Append(char) for single characters
dotnet_diagnostic.CA1835.severity = warning   # Prefer memory-based ReadAsync/WriteAsync overloads
dotnet_diagnostic.CA1836.severity = warning   # Prefer IsEmpty over Count when available
dotnet_diagnostic.CA1837.severity = warning   # Use Environment.ProcessId
dotnet_diagnostic.CA1838.severity = warning   # Avoid StringBuilder for P/Invoke parameters
dotnet_diagnostic.CA1839.severity = warning   # Use Environment.ProcessPath
dotnet_diagnostic.CA1840.severity = warning   # Use Environment.CurrentManagedThreadId
dotnet_diagnostic.CA1841.severity = warning   # Prefer Dictionary.Contains methods
dotnet_diagnostic.CA1845.severity = warning   # Use span-based string.Concat
dotnet_diagnostic.CA1846.severity = warning   # Prefer AsSpan over Substring
dotnet_diagnostic.CA1847.severity = warning   # Use char literal for single-character Contains
dotnet_diagnostic.CA1850.severity = warning   # Prefer Array.Empty() for zero-length arrays
dotnet_diagnostic.CA1851.severity = warning   # Possible multiple enumerations of IEnumerable
dotnet_diagnostic.CA1852.severity = warning   # Seal internal types
dotnet_diagnostic.CA1853.severity = warning   # Do not guard Dictionary.Remove with ContainsKey
dotnet_diagnostic.CA1854.severity = warning   # Prefer IDictionary.TryGetValue
dotnet_diagnostic.CA1855.severity = warning   # Clear() instead of RemoveAll()
dotnet_diagnostic.CA1858.severity = warning   # Use StartsWith with char
dotnet_diagnostic.CA1859.severity = warning   # Use concrete types when possible
dotnet_diagnostic.CA1860.severity = warning   # Prefer StringBuilder.Length
dotnet_diagnostic.CA1861.severity = warning   # Avoid constant arrays as arguments (repeated allocation)
dotnet_diagnostic.CA1862.severity = warning   # Prefer StringComparer methods
dotnet_diagnostic.CA1863.severity = warning   # Use CompositeFormat
dotnet_diagnostic.CA1864.severity = warning   # Prefer IDictionary.TryAdd
dotnet_diagnostic.CA1865.severity = warning   # Use char overload of StartsWith
dotnet_diagnostic.CA1866.severity = warning   # Use char overload of StartsWith
dotnet_diagnostic.CA1867.severity = warning   # Use string.Contains(char)
dotnet_diagnostic.CA1868.severity = warning   # Use char overload of EndsWith
dotnet_diagnostic.CA1869.severity = warning   # Cache JsonSerializerOptions instances
dotnet_diagnostic.CA1870.severity = warning   # Use Length/Count instead of Count() on known collections
dotnet_diagnostic.CA1871.severity = warning   # Do not pass a nullable struct
dotnet_diagnostic.CA1872.severity = warning   # Prefer Convert.ToHexString
dotnet_diagnostic.CA1873.severity = warning   # Use log level guards for expensive arguments
dotnet_diagnostic.CA2000.severity = warning   # Dispose objects before losing scope
dotnet_diagnostic.CA2002.severity = warning   # Do not lock on objects with weak identity
dotnet_diagnostic.CA2008.severity = warning   # Do not create tasks without passing a TaskScheduler
dotnet_diagnostic.CA2009.severity = warning   # Do not call ToImmutableCollection on an ImmutableCollection value
dotnet_diagnostic.CA2011.severity = warning   # Avoid infinite recursion for properties named 'Value'
dotnet_diagnostic.CA2012.severity = warning   # Use ValueTasks correctly
dotnet_diagnostic.CA2013.severity = warning   # Do not use ReferenceEquals with value types
dotnet_diagnostic.CA2014.severity = warning   # Do not use stackalloc in loops
dotnet_diagnostic.CA2015.severity = warning   # Do not define finalizers for types derived from MemoryManager<T>
dotnet_diagnostic.CA2016.severity = warning   # Forward CancellationToken to methods that take one
dotnet_diagnostic.CA2017.severity = warning   # Parameter count mismatch
dotnet_diagnostic.CA2018.severity = warning   # Use correct count parameter for Buffer.BlockCopy
dotnet_diagnostic.CA2201.severity = warning   # Do not raise reserved exception types
dotnet_diagnostic.CA2208.severity = warning   # Instantiate argument exceptions correctly
dotnet_diagnostic.CA2213.severity = warning   # Disposable fields should be disposed
dotnet_diagnostic.CA2214.severity = warning   # Do not call overridable methods in constructors
dotnet_diagnostic.CA2249.severity = warning   # Prefer string.Contains over string.IndexOf
dotnet_diagnostic.CA2255.severity = warning   # ModuleInitializer should not be used in libraries
dotnet_diagnostic.CA2256.severity = warning   # All interface members must have an implementation
dotnet_diagnostic.CA2258.severity = warning   # DynamicInterfaceCastableImplementation

# SYSLIB diagnostics
dotnet_diagnostic.SYSLIB1054.severity = none     # Use LibraryImport instead of DllImport (risky P/Invoke changes)

# Per-file overrides

# DashboardViewModel uses JSON keys that don't match property names by design
[src/Dashboard/DashboardViewModel.cs]
dotnet_diagnostic.CA1507.severity = none

# Keep translations.json in compact single-line format — no formatter expansion
[src/Pricing/translations.json]
indent_style = space
indent_size = 1
insert_final_newline = false

